source leaprc.protein.ff19SB
source leaprc.water.opc
source leaprc.gaff2
addAtomTypes { { "M1" "Fe" "sp3" } { "Y1" "N" "sp3" } { "Y2" "N" "sp3" } { "Y3" "N" "sp3" } { "Y4" "O" "sp3" } { "Y5" "O" "sp3" } }
HD1=loadmol2 HD1.mol2
HD2=loadmol2 HD2.mol2
HD3=loadmol2 HD3.mol2
IE1=loadmol2 IE1.mol2
FE1=loadmol2 FE1.mol2
OH1=loadmol2 OH1.mol2
loadamberparams frcmod.ionslm_126_opc
loadamberparams SLO_mcpbpy.frcmod
mol = loadpdb SLO_mcpbpy.pdb
charge mol
quit
